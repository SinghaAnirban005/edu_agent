# .env.example
# ─── Database ────────────────────────────────────────────────────────────────
# Local (via docker-compose): postgresql://learnai:learnai_secret@localhost:5432/learnai_db
DATABASE_URL="postgresql://learnai:learnai_secret@localhost:5432/learnai_db"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local (via docker-compose): redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ─── Groq ────────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY="gsk_your_key_here"

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
